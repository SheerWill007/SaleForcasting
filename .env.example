# ═══════════════════════════════════════════════════════════════════════════
# BACKEND ENVIRONMENT VARIABLES (FastAPI on Render)
# ═══════════════════════════════════════════════════════════════════════════

# Directory where datasets are stored (generated on first run if empty)
# Default: backend/data
SF_DATA_DIR=backend/data

# Directory where trained model files are saved
# Default: backend/models
SF_MODEL_DIR=backend/models

# IMPORTANT: Port for production deployment
# Render automatically sets this. DO NOT set manually on Render.
# For local development, defaults to 8000.
# PORT=8000

# Comma-separated list of allowed CORS origins for the API
# Local development: http://localhost:3000
# Production: Add your Vercel frontend URL here
# Example: SF_CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
SF_CORS_ORIGINS=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════════════
# FRONTEND ENVIRONMENT VARIABLES (Next.js on Vercel)
# ═══════════════════════════════════════════════════════════════════════════

# Base URL of the FastAPI backend used by Next.js dev-server rewrites
# Only used in development mode. Defaults to http://127.0.0.1:8000
# API_URL=http://127.0.0.1:8000

# ⚠️  CRITICAL FOR PRODUCTION: Public API base URL embedded at build time
# This MUST be set on Vercel to your Render backend URL
# Example for Render: NEXT_PUBLIC_API_URL=https://salescast-api.onrender.com
# Example for local: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Leave EMPTY for local development (uses dev-mode proxy)
# NEXT_PUBLIC_API_URL=

# ═══════════════════════════════════════════════════════════════════════════
# DEPLOYMENT NOTES
# ═══════════════════════════════════════════════════════════════════════════
# 
# RENDER (Backend):
# - Set SF_CORS_ORIGINS to include your Vercel domain
# - DO NOT set PORT (Render sets it automatically)
# - SF_DATA_DIR and SF_MODEL_DIR use defaults (ephemeral storage)
#
# VERCEL (Frontend):
# - Set NEXT_PUBLIC_API_URL to your Render backend URL
# - Example: https://salescast-api.onrender.com
# - Changing this requires rebuilding the frontend (it's baked into the bundle)
#
# ═══════════════════════════════════════════════════════════════════════════
