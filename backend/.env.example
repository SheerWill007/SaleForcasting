# Backend environment variables for local development
# Copy this to .env and customize as needed

# Data directory (generated sample data + user uploads)
SF_DATA_DIR=data

# Model directory (trained model cache)
SF_MODEL_DIR=models

# CORS allowed origins (comma-separated)
# Add your frontend URLs here
SF_CORS_ORIGINS=http://localhost:3000

# Port (Render sets this automatically in production)
# PORT=8000
