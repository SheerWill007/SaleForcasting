# Frontend environment variables

# Development only: API proxy target (defaults to http://127.0.0.1:8000)
# API_URL=http://127.0.0.1:8000

# CRITICAL FOR PRODUCTION DEPLOYMENT:
# This must be set to your Render backend URL when deploying to Vercel
# Example: NEXT_PUBLIC_API_URL=https://salescast-api.onrender.com
# Leave empty for local development (uses the dev proxy)
NEXT_PUBLIC_API_URL=
